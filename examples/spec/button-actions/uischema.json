{
  "type": "VerticalLayout",
  "options": {
    "gap": "1rem"
  },
  "elements": [
    {
      "type": "Label",
      "i18n": "intro",
      "text": "A Button invokes a command. It does not know what the command means - it hands it to the host and waits."
    },
    {
      "type": "Control",
      "scope": "#/properties/fullName"
    },
    {
      "type": "Control",
      "scope": "#/properties/email"
    },
    {
      "type": "Control",
      "scope": "#/properties/newsletter"
    },
    {
      "type": "Categorization",
      "elements": [
        {
          "type": "Category",
          "name": "action",
          "i18n": "actionTab",
          "label": "Action",
          "elements": [
            {
              "type": "Label",
              "i18n": "locale",
              "text": "These two buttons change the language of the form around them - including the tab labels above."
            },
            {
              "type": "HorizontalLayout",
              "options": {
                "gap": "0.5rem",
                "gridColumns": 12
              },
              "elements": [
                {
                  "type": "Button",
                  "label": "English",
                  "action": "setLocale",
                  "params": {
                    "locale": "en"
                  },
                  "color": "secondary",
                  "options": {
                    "layout": {
                      "span": 6
                    },
                    "fullWidth": true
                  }
                },
                {
                  "type": "Button",
                  "label": "Български",
                  "action": "setLocale",
                  "params": {
                    "locale": "bg"
                  },
                  "color": "secondary",
                  "options": {
                    "layout": {
                      "span": 6
                    },
                    "fullWidth": true
                  }
                }
              ]
            },
            {
              "type": "Separator"
            },
            {
              "type": "Label",
              "i18n": "colours",
              "text": "Colours are semantic names, not paint: the theme decides what each one looks like."
            },
            {
              "type": "HorizontalLayout",
              "options": {
                "gap": "0.5rem"
              },
              "elements": [
                {
                  "type": "Button",
                  "i18n": "submit",
                  "label": "Submit",
                  "action": "submit",
                  "color": "primary"
                },
                {
                  "type": "Button",
                  "i18n": "reset",
                  "label": "Reset",
                  "action": "reset",
                  "color": "secondary"
                },
                {
                  "type": "Button",
                  "i18n": "discard",
                  "label": "Discard",
                  "action": "discard",
                  "color": "error"
                }
              ]
            },
            {
              "type": "Label",
              "i18n": "disabled",
              "text": "A disabled button still says what it would do."
            },
            {
              "type": "Button",
              "label": "Unavailable",
              "action": "submit",
              "options": {
                "disabled": true
              }
            },
            {
              "type": "Label",
              "i18n": "slow",
              "text": "A slow command: the button shows a spinner and refuses a second press until it finishes."
            },
            {
              "type": "Button",
              "label": "Submit slowly",
              "action": "slowExample",
              "color": "primary"
            },
            {
              "type": "Label",
              "i18n": "neither",
              "text": "Declares neither. It still fires an event, with an empty action, rather than being a dead control."
            },
            {
              "type": "Button",
              "label": "Declares neither",
              "color": "secondary"
            }
          ]
        },
        {
          "type": "Category",
          "name": "script",
          "i18n": "scriptTab",
          "label": "Script",
          "elements": [
            {
              "type": "Label",
              "i18n": "script",
              "text": "A script button runs a string. It only works because this example grants permission."
            },
            {
              "type": "Button",
              "label": "Log the form data",
              "color": "alternative",
              "script": "console.log(this.context.core.data);"
            },
            {
              "type": "Separator"
            },
            {
              "type": "Label",
              "i18n": "conflict",
              "text": "Declares an action and a script. The action wins, and the console says so."
            },
            {
              "type": "Button",
              "label": "Declares both",
              "action": "submit",
              "script": "console.log('never runs');",
              "color": "warning"
            }
          ]
        }
      ]
    }
  ]
}
